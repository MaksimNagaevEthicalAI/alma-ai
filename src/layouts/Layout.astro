---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "ALMA AI" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>

    <meta
      name="description"
      content="ALMA AI is an ethical AI research initiative exploring long-term relationship compatibility through artificial intelligence and psychology."
    />
  </head>

  <body>
    <slot />
  </body>
</html>