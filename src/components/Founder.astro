---
import { SOCIALS } from "../config/socials";
---

<section class="founder">

  <div class="founder-container">

    <img
      src="/images/maksim.jpg"
      alt="Maksim Nagaev"
      class="photo"
    />

    <span class="eyebrow">
      Founder
    </span>

    <h2>
      Maksim Nagaev
    </h2>

    <p class="subtitle">
      Independent AI Researcher
    </p>

    <div class="text">

      <p>
        ALMA AI began from a simple question:
        why do intelligent people still struggle
        to understand themselves and each other?
      </p>

      <p>
        My research combines psychology,
        structured dialogue and transparent
        artificial intelligence to help people
        make better long-term relationship
        decisions.
      </p>

    </div>

    <div class="links">

      <a
        href={SOCIALS.github}
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub
      </a>

      <a
        href={SOCIALS.medium}
        target="_blank"
        rel="noopener noreferrer"
      >
        Medium
      </a>

      <a
        href={SOCIALS.linkedin}
        target="_blank"
        rel="noopener noreferrer"
      >
        LinkedIn
      </a>

      <a
        href={SOCIALS.notion}
        target="_blank"
        rel="noopener noreferrer"
      >
        Notion
      </a>

    </div>

  </div>

</section>

<style>

.founder{

    padding:140px 24px;

    background:#ffffff;

}

.founder-container{

    max-width:760px;

    margin:auto;

    text-align:center;

}

.photo{

    width:170px;

    height:170px;

    border-radius:50%;

    object-fit:cover;

    display:block;

    margin:0 auto 36px;

    box-shadow:0 18px 45px rgba(0,0,0,.12);

}

.eyebrow{

    display:inline-block;

    padding:8px 18px;

    border-radius:999px;

    background:#eef4ff;

    color:#2563eb;

    font-size:14px;

    font-weight:600;

    margin-bottom:18px;

}

.founder h2{

    font-size:56px;

    line-height:1.1;

    color:#111827;

    margin:0 0 12px;

}

.subtitle{

    font-size:22px;

    color:#2563eb;

    margin-bottom:40px;

}

.text{

    max-width:650px;

    margin:0 auto;

}

.text p{

    font-size:21px;

    line-height:1.9;

    color:#5b6472;

    margin-bottom:22px;

}

.links{

    margin-top:46px;

    display:flex;

    justify-content:center;

    flex-wrap:wrap;

    gap:16px;

}

.links a{

    padding:14px 26px;

    border:1px solid #d7dce3;

    border-radius:14px;

    text-decoration:none;

    color:#111827;

    font-weight:600;

    transition:.25s;

}

.links a:hover{

    background:#f4f6f8;

    transform:translateY(-2px);

}

@media(max-width:900px){

    .founder{

        padding:100px 24px;

    }

    .photo{

        width:140px;

        height:140px;

    }

    .founder h2{

        font-size:42px;

    }

    .subtitle{

        font-size:20px;

    }

    .text p{

        font-size:18px;

        line-height:1.8;

    }

}

</style>