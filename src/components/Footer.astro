---
import { SOCIALS } from "../config/socials";
---

<footer class="footer">

    <div class="footer-inner">

        <div class="footer-brand">

            <h3>
                ALMA AI
            </h3>

            <p>
                Ethical artificial intelligence for understanding
                people, relationships, and long-term compatibility.
            </p>

        </div>

        <div class="footer-column">

            <h4>
                Explore
            </h4>

            <nav>

                <a href="/register">
                    Dialogue
                </a>

                <a href="/research">
                    Research
                </a>

                <a href="/articles">
                    Articles
                </a>

                <a href="/about">
                    About
                </a>

            </nav>

        </div>

        <div class="footer-column">

            <h4>
                Connect
            </h4>

            <nav>

                <a
                    href={SOCIALS.linkedin}
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    LinkedIn
                </a>

                <a
                    href={SOCIALS.medium}
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Medium
                </a>

                <a
                    href={SOCIALS.substack}
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Substack
                </a>

                <a
                    href={SOCIALS.notion}
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Notion Research
                </a>

            </nav>

        </div>

    </div>

    <div class="copyright">

        © 2026 ALMA AI — Independent Research Initiative

    </div>

</footer>

<style>

.footer{

    background:#111827;

    color:white;

    padding:70px 40px 30px;

}

.footer-inner{

    max-width:1100px;

    margin:0 auto;

    display:grid;

    grid-template-columns:2fr 1fr 1fr;

    gap:60px;

}

.footer h3{

    font-size:24px;

    margin:0 0 20px;

}

.footer h4{

    margin:0 0 20px;

}

.footer p{

    color:#cbd5e1;

    line-height:1.7;

    max-width:350px;

}

.footer nav{

    display:flex;

    flex-direction:column;

    gap:12px;

}

.footer a{

    color:#cbd5e1;

    text-decoration:none;

    transition:.2s;

}

.footer a:hover{

    color:white;

}

.copyright{

    max-width:1100px;

    margin:50px auto 0;

    padding-top:20px;

    border-top:1px solid #334155;

    color:#94a3b8;

    font-size:14px;

}

@media(max-width:700px){

    .footer-inner{

        grid-template-columns:1fr;

    }

}

</style>