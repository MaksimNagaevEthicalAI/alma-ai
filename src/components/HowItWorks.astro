---
const steps = [
  {
    title: "Start a Dialogue",
    text: "Begin with yourself, another person, or an existing relationship."
  },
  {
    title: "Reveal Patterns",
    text: "ALMA identifies emotional, behavioral and psychological patterns through structured conversation."
  },
  {
    title: "Transparent Insights",
    text: "Every conclusion is explained. No hidden scores. No black-box predictions."
  },
  {
    title: "Better Decisions",
    text: "Understand compatibility before making important relationship choices."
  }
];

function num(i: number) {
  return String(i + 1).padStart(2, "0");
}
---

<section class="how">

    <div class="how-container">

        <div class="how-head">

            <h2>How ALMA Works</h2>

            <p>
                ALMA doesn't tell people who to love. It helps them
                understand themselves, recognize relationship patterns,
                and make more thoughtful long-term decisions.
            </p>

        </div>

        <div class="steps">

            {
                steps.map((step, i) => (

                    <div class="step">

                        <span class="step-num">{num(i)}</span>

                        <h3>{step.title}</h3>

                        <p>{step.text}</p>

                    </div>

                ))
            }

        </div>

    </div>

</section>

<style>

@import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,340..600&family=Inter:wght@400;500;600;700&display=swap');

.how{

    padding:110px 24px;

    background:#f8fafc;

    font-family:'Inter',system-ui,sans-serif;

}

.how-container{

    max-width:1080px;

    margin:0 auto;

}

.how-head{

    max-width:560px;

    margin:0 auto 72px;

    text-align:center;

}

.how-head h2{

    font-family:'Fraunces',serif;

    font-optical-sizing:auto;

    font-weight:440;

    font-size:38px;

    letter-spacing:-.01em;

    color:#111827;

    margin:0 0 18px;

}

.how-head p{

    font-size:17px;

    line-height:1.75;

    color:#5b6472;

    margin:0;

}

.steps{

    display:grid;

    grid-template-columns:repeat(4, 1fr);

    gap:0;

}

.step{

    position:relative;

    padding:0 28px;

}

.step + .step{

    border-left:1px solid #e3e8ef;

}

.step-num{

    display:block;

    font-family:'Fraunces',serif;

    font-weight:420;

    font-size:22px;

    color:#2563eb;

    margin-bottom:18px;

}

.step h3{

    font-family:'Fraunces',serif;

    font-weight:480;

    font-size:20px;

    color:#111827;

    margin:0 0 12px;

}

.step p{

    font-size:15px;

    line-height:1.7;

    color:#5b6472;

    margin:0;

}

@media(max-width:900px){

    .how{

        padding:72px 20px;

    }

    .how-head{

        margin-bottom:48px;

    }

    .how-head h2{

        font-size:30px;

    }

    .steps{

        grid-template-columns:1fr;

        gap:36px;

    }

    .step{

        padding:0 0 0 24px;

        border-left:2px solid #e3e8ef;

    }

    .step + .step{

        border-left:2px solid #e3e8ef;

    }

}

</style>
