---
import Layout from "../layouts/Layout.astro";

const GOALS = [

    {
        id: "self_understanding",
        title: "Better understand myself",
        description:
            "Gain a deeper understanding of how I think, feel and behave."
    },

    {
        id: "relationship_patterns",
        title: "Understand my relationship patterns",
        description:
            "Recognize recurring dynamics in my relationships."
    },

    {
        id: "healthy_relationships",
        title: "Build healthier relationships",
        description:
            "Develop stronger and more stable relationships."
    },

    {
        id: "partner",
        title: "Find a compatible long-term partner",
        description:
            "Understand what kind of relationship is truly right for me."
    },

    {
        id: "communication",
        title: "Improve communication",
        description:
            "Express myself more clearly and understand others better."
    },

    {
        id: "emotions",
        title: "Become more emotionally aware",
        description:
            "Better recognize and understand my emotional reactions."
    },

    {
        id: "fears",
        title: "Understand my fears and inner obstacles",
        description:
            "Explore what may be preventing me from moving forward."
    },

    {
        id: "confidence",
        title: "Increase self-confidence",
        description:
            "Develop greater confidence in myself and my decisions."
    },

    {
        id: "decisions",
        title: "Make better life decisions",
        description:
            "Improve the way I approach important choices."
    },

    {
        id: "recovery",
        title: "Recover after a difficult relationship",
        description:
            "Process difficult experiences and move forward."
    },

    {
        id: "emotional_patterns",
        title: "Understand my emotional reactions",
        description:
            "Notice patterns in how I respond emotionally."
    },

    {
        id: "other",
        title: "Something else",
        description:
            "Describe your own goal in your own words."
    }

];
---

<Layout title="Your Goals | ALMA AI">

<section class="goals">

<div class="card">

<span class="badge">

Before we begin

</span>

<h1>

If ALMA could truly help you,

what would you hope to gain?

</h1>

<p class="intro">

There are no right or wrong answers.

Your expectations do not define you.

They simply help ALMA choose

the best place to begin.

You may choose more than one option.

</p>

<form id="goalsForm">

<div class="goal-list">

{

GOALS.map((goal,index)=>(

<label class="goal">

<input

type="checkbox"

id={`goal-${index}`}

value={goal.title}

/>

<div class="goal-content">

<h2>

{goal.title}

</h2>

<p>

{goal.description}

</p>

</div>

</label>

))

}

</div>

<div

id="otherContainer"

class="other"

style="display:none;"

>

<label>

Tell ALMA in your own words

</label>

<textarea

id="otherGoal"

rows="6"

placeholder="Describe what you hope to gain from ALMA..."

></textarea>

</div>

<div class="buttons">

<a

href="/register"

class="back"

>

← Back

</a>

<button

type="submit"

class="continue"

>

Continue →

</button>

</div>

</form>

</div>

</section>

<script>

const form=document.getElementById("goalsForm");

const lastCheckbox=document.getElementById("goal-11");

const container=document.getElementById("otherContainer");

lastCheckbox?.addEventListener("change",()=>{

container.style.display=

lastCheckbox.checked

? "block"

: "none";

});

form?.addEventListener("submit",(event)=>{

event.preventDefault();

const selected=[];

document

.querySelectorAll(".goal input:checked")

.forEach((checkbox)=>{

selected.push(checkbox.value);

});

const other=document

.getElementById("otherGoal")

.value

.trim();

const goals={

selected,

other

};

localStorage.setItem(

"goals",

JSON.stringify(goals)

);

window.location.href="/questionnaire";

});

</script>

<style>

.goals{

min-height:100vh;

padding:80px 24px;

background:#f8fafc;

}

.card{

max-width:920px;

margin:auto;

background:white;

border-radius:24px;

padding:50px;

box-shadow:0 20px 60px rgba(0,0,0,.08);

}

.badge{

display:inline-block;

padding:8px 18px;

border-radius:999px;

background:#eef4ff;

color:#2563eb;

font-weight:600;

margin-bottom:24px;

}

h1{

font-size:46px;

line-height:1.15;

margin-bottom:24px;

color:#111827;

}

.intro{

font-size:19px;

line-height:1.9;

color:#64748b;

margin-bottom:44px;

}

.goal-list{

display:grid;

gap:18px;

}

.goal{

display:flex;

align-items:flex-start;

gap:18px;

padding:22px;

border:1px solid #dbe3ea;

border-radius:18px;

cursor:pointer;

transition:.2s;

}

.goal:hover{

border-color:#2563eb;

background:#f8fbff;

transform:translateY(-2px);

}

.goal input{

margin-top:6px;

transform:scale(1.25);

cursor:pointer;

}

.goal-content{

flex:1;

}

.goal-content h2{

font-size:20px;

font-weight:600;

color:#111827;

margin:0 0 8px;

line-height:1.35;

}

.goal-content p{

font-size:16px;

line-height:1.7;

color:#64748b;

margin:0;

}

.other{

margin-top:40px;

padding-top:30px;

border-top:1px solid #edf2f7;

}

.other label{

display:block;

font-size:17px;

font-weight:600;

color:#111827;

margin-bottom:16px;

}

.other textarea{

width:100%;

resize:vertical;

min-height:140px;

padding:18px;

border:1px solid #dbe3ea;

border-radius:16px;

font-size:16px;

font-family:inherit;

line-height:1.7;

transition:.2s;

}

.other textarea:focus{

outline:none;

border-color:#2563eb;

}

.buttons{

display:flex;

justify-content:space-between;

align-items:center;

margin-top:50px;

}

.back{

display:inline-flex;

align-items:center;

justify-content:center;

padding:16px 28px;

border:1px solid #d1d5db;

border-radius:14px;

font-weight:600;

color:#111827;

transition:.2s;

}

.back:hover{

background:#f3f4f6;

}

.continue{

border:none;

background:#2563eb;

color:white;

padding:16px 36px;

border-radius:14px;

font-size:17px;

font-weight:600;

cursor:pointer;

transition:.2s;

}

.continue:hover{

background:#1d4ed8;

}

@media(max-width:900px){

.card{

padding:36px;

}

h1{

font-size:38px;

}

.intro{

font-size:18px;

}

.goal{

padding:18px;

}

.goal-content h2{

font-size:18px;

}

.goal-content p{

font-size:15px;

}

}

@media(max-width:700px){

.goals{

padding:50px 18px;

}

.card{

padding:26px;

}

h1{

font-size:32px;

line-height:1.2;

}

.intro{

font-size:17px;

line-height:1.8;

}

.goal{

flex-direction:row;

align-items:flex-start;

padding:16px;

}

.goal input{

margin-top:4px;

}

.buttons{

flex-direction:column;

gap:18px;

}

.back,

.continue{

width:100%;

text-align:center;

justify-content:center;

}

}

</style>

</Layout>