---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
---

<Layout title="About | ALMA AI">
  <Header />

  <main class="container page">
    <h1>About ALMA AI</h1>

    <p>
      ALMA AI is an independent research initiative founded by
      Maksim Nagaev to study ethical artificial intelligence,
      psychology, and long-term relationship compatibility.
    </p>
  </main>
</Layout>

<style>
.page{
    padding:100px 20px;
}

.page h1{
    font-size:54px;
    margin-bottom:25px;
}

.page p{
    font-size:22px;
    max-width:900px;
    color:var(--muted);
    line-height:1.8;
}
</style>