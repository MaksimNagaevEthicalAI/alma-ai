---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Registration | ALMA AI">

<section class="register">

    <div class="card">

        <h1>
            Welcome to ALMA
        </h1>

        <p class="intro">
            Before we begin, we'd like to learn a little about you.
            This information helps guide your first conversation with ALMA.
            Nothing here is permanent and your understanding will continue to evolve over time.
        </p>

        <form>

            <div class="section">

                <h2>
                    Why are you here today?
                </h2>

                <p class="hint">
                    Select all that apply.
                </p>

                <label><input type="checkbox"> Understand myself better</label>

                <label><input type="checkbox"> Build healthier relationships</label>

                <label><input type="checkbox"> Find a romantic partner</label>

                <label><input type="checkbox"> Find compatible friends</label>

                <label><input type="checkbox"> Better understand my emotions</label>

                <label><input type="checkbox"> Improve communication</label>

                <label><input type="checkbox"> Personal growth</label>

                <label><input type="checkbox"> Recover after a breakup</label>

                <label><input type="checkbox"> Make better life decisions</label>

                <label><input type="checkbox"> Other</label>

            </div>

            <div class="section">

                <h2>
                    Basic information
                </h2>

                <label>

                    Age

                    <input
                        type="number"
                        min="18"
                        max="120"
                    />

                </label>

                <label>

                    Country

                    <input
                        type="text"
                    />

                </label>

                <label>

                    Gender

                    <select>

                        <option>Male</option>

                        <option>Female</option>

                        <option>Prefer not to say</option>

                    </select>

                </label>

                <label>

                    Relationship Status

                    <select>

                        <option>Single</option>

                        <option>In a relationship</option>

                        <option>Married</option>

                        <option>Divorced</option>

                        <option>Widowed</option>

                        <option>Prefer not to say</option>

                    </select>

                </label>

            </div>

            <button class="continue">

                Continue →

            </button>

        </form>

    </div>

</section>

</Layout>

<style>

.register{

    padding:80px 24px;

    background:#f8fafc;

    min-height:80vh;

}

.card{

    max-width:760px;

    margin:auto;

    background:white;

    border-radius:22px;

    padding:50px;

    box-shadow:0 20px 60px rgba(0,0,0,.08);

}

h1{

    font-size:44px;

    margin-bottom:20px;

    color:#111827;

}

.intro{

    color:#64748b;

    font-size:18px;

    line-height:1.8;

    margin-bottom:40px;

}

.section{

    margin-bottom:40px;

}

.section h2{

    font-size:24px;

    margin-bottom:10px;

}

.hint{

    color:#64748b;

    margin-bottom:20px;

}

label{

    display:block;

    margin-bottom:18px;

    font-weight:500;

    color:#1f2937;

}

input[type="checkbox"]{

    margin-right:10px;

}

input[type="text"],
input[type="number"],
select{

    display:block;

    width:100%;

    margin-top:8px;

    padding:14px;

    border:1px solid #d1d5db;

    border-radius:12px;

    font-size:16px;

}

.continue{

    margin-top:20px;

    width:100%;

    background:#2563eb;

    color:white;

    border:none;

    border-radius:14px;

    padding:18px;

    font-size:18px;

    font-weight:600;

    cursor:pointer;

    transition:.2s;

}

.continue:hover{

    background:#1d4ed8;

}

@media(max-width:700px){

    .card{

        padding:30px;

    }

    h1{

        font-size:34px;

    }

}

</style>