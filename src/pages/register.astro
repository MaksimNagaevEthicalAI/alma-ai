---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Welcome | ALMA AI">

<section class="register">

    <div class="card">

        <span class="badge">
            ALMA Research Preview
        </span>

        <h1>
            Welcome to ALMA
        </h1>

        <p class="intro">

            During this research phase, creating an account,
            confirming your email address or phone number is
            <strong>not required.</strong>

        </p>

        <p class="intro">

            We only ask for a small amount of information to help
            ALMA better understand the context of your future
            conversations.

            You may skip your name if you prefer.

        </p>

        <form id="registrationForm">

            <label>

                First name (optional)

                <input
                    id="name"
                    type="text"
                    placeholder="Your name"
                />

            </label>

            <label>

                Age

                <input
                    id="age"
                    type="number"
                    min="18"
                    max="120"
                    required
                />

            </label>

            <label>

                Country

                <input
                    id="country"
                    type="text"
                    placeholder="Country"
                    required
                />

            </label>

            <label>

                Gender

                <select id="gender">

                    <option>Male</option>

                    <option>Female</option>

                    <option>Non-binary</option>

                    <option>Prefer not to say</option>

                </select>

            </label>

            <label>

                Relationship Status

                <select id="relationship">

                    <option>Single</option>

                    <option>In a relationship</option>

                    <option>Married</option>

                    <option>Divorced</option>

                    <option>Widowed</option>

                    <option>Prefer not to say</option>

                </select>

            </label>

            <label>

                Preferred language

                <select id="language">

                    <option>English</option>

                    <option>Русский</option>

                    <option>Español</option>

                </select>

            </label>

            <button
                type="submit"
                class="continue"
            >

                Continue →

            </button>

        </form>

    </div>

</section>

<script>

const form=document.getElementById("registrationForm");

form?.addEventListener("submit",(event)=>{

    event.preventDefault();

    const registration={

        name:document.getElementById("name").value,

        age:document.getElementById("age").value,

        country:document.getElementById("country").value,

        gender:document.getElementById("gender").value,

        relationship:document.getElementById("relationship").value,

        language:document.getElementById("language").value

    };

    localStorage.setItem(

        "registration",

        JSON.stringify(registration)

    );

    window.location.href="/goals";

});

</script>

<style>

.register{

    min-height:100vh;

    background:#f8fafc;

    padding:80px 24px;

}

.card{

    max-width:760px;

    margin:auto;

    background:white;

    border-radius:24px;

    padding:50px;

    box-shadow:0 20px 60px rgba(0,0,0,.08);

}

.badge{

    display:inline-block;

    padding:8px 18px;

    border-radius:999px;

    background:#eef4ff;

    color:#2563eb;

    font-weight:600;

    margin-bottom:24px;

}

h1{

    font-size:44px;

    color:#111827;

    margin-bottom:20px;

}

.intro{

    font-size:18px;

    line-height:1.8;

    color:#64748b;

    margin-bottom:20px;

}

form{

    margin-top:40px;

}

label{

    display:block;

    margin-bottom:24px;

    font-weight:600;

    color:#111827;

}

input,

select{

    width:100%;

    margin-top:8px;

    padding:16px;

    border:1px solid #dbe3ea;

    border-radius:14px;

    font-size:16px;

    font-family:inherit;

}

input:focus,

select:focus{

    outline:none;

    border-color:#2563eb;

}

.continue{

    width:100%;

    margin-top:20px;

    border:none;

    background:#2563eb;

    color:white;

    padding:18px;

    border-radius:14px;

    font-size:18px;

    font-weight:600;

    cursor:pointer;

    transition:.2s;

}

.continue:hover{

    background:#1d4ed8;

}

@media(max-width:700px){

    .card{

        padding:30px;

    }

    h1{

        font-size:34px;

    }

}

</style>

</Layout>