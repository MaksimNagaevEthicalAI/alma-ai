---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
---

<Layout title="Publications | ALMA AI">
  <Header />

  <main class="container page">
    <h1>Publications</h1>

    <p>
      Research papers, essays, and long-form articles published as part of
      the ALMA AI research initiative.
    </p>
  </main>
</Layout>

<style>
.page{
    padding:100px 20px;
}

.page h1{
    font-size:54px;
    margin-bottom:25px;
}

.page p{
    font-size:22px;
    max-width:900px;
    color:var(--muted);
    line-height:1.8;
}
</style>