---

<Layout title="Articles | ALMA AI">

<section class="articles">

  <div class="articles-container">

    <div class="masthead">

      <span class="eyebrow">The Ideas That Shaped ALMA</span>

      <h1>ALMA didn't begin with answers. It began with questions.</h1>

      <p class="deck">
        These essays explore the relationship patterns, emotional dynamics,
        and psychological ideas that gradually became part of how ALMA
        understands people. They are not documentation of the product —
        they are part of its foundation.
      </p>

    </div>

    <ul class="list">

      {
        articles.map((article) => (

          <li class="row">

            <a
              href={article.url}
              target="_blank"
              rel="noopener noreferrer"
              class="article"
            >

              <span class="title">
                {article.title}
              </span>

              <span class="go" aria-hidden="true">
                ↗
              </span>

            </a>

          </li>

        ))
      }

    </ul>

  </div>

</section>

</Layout>

<style>

@import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,340..600&family=Inter:wght@400;500;600;700&display=swap');

.articles{

    padding:100px 24px 140px;
    background:#f8fafc;
    font-family:'Inter',system-ui,sans-serif;

}

.articles-container{

    max-width:960px;
    margin:0 auto;

}

.masthead{

    margin-bottom:72px;
    max-width:760px;

}

.eyebrow{

    display:block;
    font-size:13px;
    font-weight:600;
    letter-spacing:.14em;
    text-transform:uppercase;
    color:#2563eb;
    margin-bottom:20px;

}

.masthead h1{

    font-family:'Fraunces',serif;
    font-optical-sizing:auto;
    font-weight:440;
    font-size:44px;
    line-height:1.22;
    letter-spacing:-.01em;
    color:#111827;
    margin:0 0 22px;

}

.deck{

    font-size:18px;
    line-height:1.7;
    color:#64748b;
    max-width:58ch;
    margin:0;

}

.list{

    list-style:none;
    margin:0;
    padding:0;
    border-top:1px solid #e3e8ef;

}

.row{

    border-bottom:1px solid #e3e8ef;

}

.article{

    position:relative;

    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:28px;

    padding:30px 14px;

    text-decoration:none;

    transition:padding-left .3s ease, background-color .3s ease;

}

.article::before{

    content:"";
    position:absolute;
    left:0;
    top:0;
    bottom:0;
    width:3px;
    background:#2563eb;

    transform:scaleY(0);
    transform-origin:center;
    transition:transform .3s ease;

}

.article:hover{

    background:#ffffff;
    padding-left:26px;

}

.article:hover::before{

    transform:scaleY(1);

}

.title{

    flex:1;
    min-width:0;

    font-family:'Fraunces',serif;
    font-weight:460;
    font-size:23px;
    line-height:1.4;
    letter-spacing:-.005em;
    color:#111827;

    transition:color .3s ease;

}

.article:hover .title{

    color:#1d4ed8;

}

.go{

    flex-shrink:0;

    display:flex;
    align-items:center;
    justify-content:center;

    width:38px;
    height:38px;
    border-radius:999px;
    border:1px solid #dbe3ea;

    font-size:16px;
    color:#9aa4b2;

    transition:
        background-color .3s ease,
        border-color .3s ease,
        color .3s ease,
        transform .3s ease;

}

.article:hover .go{

    background:#2563eb;
    border-color:#2563eb;
    color:#ffffff;
    transform:translate(2px,-2px);

}

@media(max-width:900px){

    .articles{

        padding:64px 20px 100px;

    }

    .masthead{

        margin-bottom:48px;

    }

    .masthead h1{

        font-size:30px;

    }

    .deck{

        font-size:16px;

    }

    .article{

        gap:16px;
        padding:24px 10px;

    }

    .article:hover{

        padding-left:10px;

    }

    .article::before{

        display:none;

    }

    .title{

        font-size:19px;

    }

    .go{

        width:32px;
        height:32px;
        font-size:14px;

    }

}

</style>
