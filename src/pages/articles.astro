---
import Layout from "../layouts/Layout.astro";

const articles = [
  {
    title: "Why Love After 40 Can Be the Happiest Love of Your Life",
    url: "https://medium.com/@maksimnagaev/why-love-after-40-can-be-the-happiest-love-of-your-life-9b33f589e22a"
  },
  {
    title: "You Don't Miss Them. You Miss How They Made You Feel",
    url: "https://medium.com/@maksimnagaev/you-dont-miss-them-you-miss-how-they-made-you-feel-d4ff27232cf2"
  },
  {
    title: "Love Is When Your Heart Still Beats Faster After Years and Distance",
    url: "https://medium.com/@maksimnagaev/love-is-when-your-heart-still-beats-faster-after-years-and-distance-a47530b3363c"
  },
  {
    title: "ADHD in Relationships",
    url: "https://medium.com/@maksimnagaev/adhd-in-relationships-f57343002a85"
  },
  {
    title: "Why Vacation Romances Feel Like Real Love",
    url: "https://medium.com/@maksimnagaev/why-vacation-romances-feel-like-real-love-7a0e129d3498"
  },
  {
    title: "For Some People, Stable Relationships Feel Emotionally Unsafe",
    url: "https://medium.com/@maksimnagaev/for-some-people-stable-relationships-feel-emotionally-unsafe-726d044cd95f"
  },
  {
    title: "Age Gap Relationships Don't Fail for the Reason You Think",
    url: "https://medium.com/@maksimnagaev/age-gap-relationships-dont-fail-for-the-reason-you-think-8d3c3d8a1dbc"
  },
  {
    title: "Would You Start a Relationship If You Knew How It Ends?",
    url: "https://medium.com/@maksimnagaev/would-you-start-a-relationship-if-you-knew-how-it-ends-f6a0060564bc"
  },
  {
    title: "Why Some Romantic Connections Feel Karmic — Even When They're Not",
    url: "https://medium.com/@maksimnagaev/why-some-romantic-connections-feel-karmic-even-when-theyre-not-066bdb7e227b"
  },
  {
    title: "When a Relationship Gets Quiet, People Think Love Is Gone — But It Isn't",
    url: "https://medium.com/@maksimnagaev/when-a-relationship-gets-quiet-people-think-love-is-gone-but-it-isnt-e933ccb0617c"
  },
  {
    title: "Most Relationships End Before the Breakup",
    url: "https://medium.com/@maksimnagaev/most-relationships-end-before-the-breakup-fd07c849f2bf"
  },
  {
    title: "Can Friends With Benefits Really Stay Casual?",
    url: "https://medium.com/@maksimnagaev/can-friends-with-benefits-really-stay-casual-0006a8f6b12b"
  },
  {
    title: "One Gives Care. The Other Feels Control.",
    url: "https://medium.com/@maksimnagaev/one-gives-care-the-other-feels-control-youre-not-misaligned-you-re-misunderstanding-each-other-049c082ac6fb"
  }
];
---

<Layout title="Articles | ALMA AI">

<section class="articles">

  <div class="articles-container">

    <h1>Selected Essays</h1>

    {
      articles.map((article) => (

        <a
          href={article.url}
          target="_blank"
          rel="noopener noreferrer"
          class="article"
        >

          <span class="title">
            {article.title}
          </span>

          <span class="arrow">
            ↗
          </span>

        </a>

      ))
    }

  </div>

</section>

</Layout>

<style>

.articles{

    padding:90px 24px 120px;
    background:#f8fafc;

}

.articles-container{

    max-width:920px;
    margin:0 auto;

}

.articles h1{

    font-size:52px;
    font-weight:700;
    letter-spacing:-2px;
    color:#111827;
    margin-bottom:56px;

}

.article{

    display:flex;
    justify-content:space-between;
    align-items:flex-start;

    gap:56px;

    padding:26px 0;

    border-bottom:1px solid #eef2f7;

    text-decoration:none;

}

.title{

    flex:1;

    font-size:27px;

    font-weight:600;

    line-height:1.4;

    color:#111827;

    transition:color .25s ease;

}

.arrow{

    flex-shrink:0;

    font-size:22px;

    color:#9ca3af;

    margin-top:5px;

    transition:
        color .25s ease,
        transform .25s ease;

}

.article:hover .title{

    color:#4b5563;

}

.article:hover .arrow{

    color:#111827;

    transform:translateX(6px);

}

@media(max-width:900px){

    .articles{

        padding:60px 24px 90px;

    }

    .articles h1{

        font-size:40px;
        margin-bottom:42px;

    }

    .article{

        gap:20px;
        padding:22px 0;

    }

    .title{

        font-size:22px;
        line-height:1.45;

    }

    .arrow{

        font-size:20px;
        margin-top:2px;

    }

}

</style>