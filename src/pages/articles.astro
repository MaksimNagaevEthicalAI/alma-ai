---

<Layout title="Articles | ALMA AI">

<section class="max-w-4xl mx-auto px-6 py-20">

  <h1 class="text-5xl font-bold mb-12">
    Selected Essays
  </h1>

  <div>

    {
      articles.map((article) => (

        <article class="py-6">

          <a
            href={article.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center justify-between gap-8 hover:text-gray-600 transition-colors"
          >

            <span class="text-2xl font-semibold leading-snug max-w-3xl">
              {article.title}
            </span>

            <span class="shrink-0 text-base font-normal text-gray-500 group-hover:text-black transition-colors">
              Medium ↗
            </span>

          </a>

        </article>

      ))
    }

  </div>

</section>

</Layout>