---
import Layout from "../layouts/Layout.astro";

import DialogueWizard from "../components/dialogue/DialogueWizard";
---

<Layout title="Start Dialogue | ALMA AI">

    <main class="dialogue">

        <DialogueWizard client:load />

    </main>

</Layout>


<style>

.dialogue{

    min-height:calc(100vh - 90px);

    display:flex;

    justify-content:center;

    align-items:center;

    padding:80px 24px;

    background:#f8fafc;

}

</style>