---
import Layout from "../layouts/Layout.astro";
---

<Layout title="ALMA Dialogue | ALMA AI">

<section class="dialogue">

    <div class="chat">

        <div class="chat-header">

            <span class="badge">

                ALMA Conversation

            </span>

            <h1>

                Welcome.

            </h1>

            <p>

                Thank you for completing the questionnaire.

                Before we continue, I'd like to understand a few things

                that questionnaires alone cannot reveal.

            </p>

        </div>

<div
    id="messages"
    class="messages"
>

    <div class="assistant">

        <div class="label">

            ALMA

        </div>

        <div class="bubble">

            Hello.

            One answer in your questionnaire caught my attention.

            Could you tell me what brought you to ALMA today?

        </div>

    </div>

</div>

        <form
            id="chatForm"
            class="input-area"
        >

            <textarea

                id="message"

                rows="3"

                placeholder="Write your answer..."

            ></textarea>

            <button type="submit">

                Send

            </button>

        </form>

    </div>

</section>

<script>

const form = document.getElementById("chatForm");
const input = document.getElementById("message");
const messages = document.getElementById("messages");

/**
 * @param {"user" | "assistant"} role
 * @param {string} text
 */
function appendBubble(role, text) {

    if (!(messages instanceof HTMLElement)) return;

    const wrapper = document.createElement("div");
    wrapper.className = role;

    const label = document.createElement("div");
    label.className = "label";
    label.textContent =
        role === "assistant"
            ? "ALMA"
            : "You";

    const bubble = document.createElement("div");
    bubble.className = "bubble";
    bubble.textContent = text;

    wrapper.appendChild(label);
    wrapper.appendChild(bubble);

    messages.appendChild(wrapper);

    messages.scrollTop = messages.scrollHeight;

}
async function sendMessage() {
    if (!(input instanceof HTMLTextAreaElement)) return;
    const text = input.value.trim();
    if (!text) return;
    appendBubble("user", text);
    input.value = "";
    appendBubble("assistant", "Thinking...");
    const thinkingBubble =
        messages instanceof HTMLElement
            ? messages.lastElementChild?.querySelector(".bubble")
            : null;
    try {
        const registration = JSON.parse(
            localStorage.getItem("registration") || "{}"
        );

        const goals = JSON.parse(
            localStorage.getItem("goals") || "{}"
        );

        const questionnaire = JSON.parse(
            localStorage.getItem("questionnaire") || "{}"
        );

        const response = await fetch("/api/chat", {

            method: "POST",

            headers: {

                "Content-Type": "application/json"

            },

            body: JSON.stringify({

                message: text,

                language: registration.language || "English",

                registration,

                goals,

                questionnaire

            })

        });
        const data = await response.json();
        if (!response.ok) {
            throw new Error(data.error || "Unknown error");
        }
        if (thinkingBubble) {
            thinkingBubble.textContent = data.reply;
        }
    }
    catch (error) {
        console.error(error);
        if (thinkingBubble) {
            thinkingBubble.textContent =
                "Sorry, something went wrong while contacting ALMA.";
        }
    }
}

if (form instanceof HTMLFormElement) {
    form.addEventListener("submit", (event) => {
        event.preventDefault();
        sendMessage();
    });
}

if (input instanceof HTMLTextAreaElement) {
    input.addEventListener("keydown", (event) => {
        if (event.key === "Enter" && !event.shiftKey) {
            event.preventDefault();
            sendMessage();
        }
    });
}

</script>

<style>

.dialogue{

    min-height:100vh;

    background:#f8fafc;

    padding:60px 24px;

}

.chat{

    max-width:900px;

    margin:auto;

    background:white;

    border-radius:24px;

    box-shadow:0 20px 60px rgba(0,0,0,.08);

    display:flex;

    flex-direction:column;

    overflow:hidden;

}

.chat-header{

    padding:40px;

    border-bottom:1px solid #edf2f7;

}

.badge{

    display:inline-block;

    padding:8px 16px;

    border-radius:999px;

    background:#eef4ff;

    color:#2563eb;

    font-size:14px;

    font-weight:600;

    margin-bottom:20px;

}

.chat-header h1{

    font-size:42px;

    color:#111827;

    margin-bottom:16px;

}

.chat-header p{

    color:#64748b;

    font-size:18px;

    line-height:1.8;

    max-width:700px;

}

.messages{

    height:520px;

    overflow-y:auto;

    padding:40px;

    background:#fafafa;

}

.assistant,
.user{

display:flex;
flex-direction:column;
margin-bottom:28px;

}

.assistant{

align-items:flex-start;

}

.user{

align-items:flex-end;

}

.assistant::before{

content:"ALMA";

font-size:13px;
font-weight:700;
color:#64748b;
margin-bottom:8px;
margin-left:6px;

}

.user::before{

content:"You";

font-size:13px;
font-weight:700;
color:#2563eb;
margin-bottom:8px;
margin-right:6px;

}

.bubble{

max-width:72%;
padding:18px 22px;
border-radius:20px;
line-height:1.8;
font-size:17px;
white-space:pre-wrap;
word-break:break-word;

box-shadow:0 8px 20px rgba(0,0,0,.05);

}

.assistant .bubble{

background:white;
border:1px solid #dbe3ea;
color:#111827;
border-top-left-radius:6px;

}

.user .bubble{

background:#2563eb;
color:white;
border-top-right-radius:6px;

}

.input-area{

    display:flex;

    gap:16px;

    padding:30px;

    border-top:1px solid #edf2f7;

    background:white;

}

textarea{

    flex:1;

    resize:none;

    border:1px solid #dbe3ea;

    border-radius:16px;

    padding:18px;

    font-size:16px;

    font-family:inherit;

    min-height:90px;

}

textarea:focus{

    outline:none;

    border-color:#2563eb;

}

button{

    width:150px;

    border:none;

    border-radius:16px;

    background:#2563eb;

    color:white;

    font-size:18px;

    font-weight:600;

    cursor:pointer;

    transition:.2s;

}

button:hover{

    background:#1d4ed8;

}

@media(max-width:900px){

    .chat-header{

        padding:30px;

    }

    .chat-header h1{

        font-size:34px;

    }

    .messages{

        padding:24px;

        height:420px;

    }

    .bubble{

        max-width:100%;

    }

    .input-area{

        flex-direction:column;

    }

    button{

        width:100%;

        height:56px;

    }

}

</style>

</Layout>
